# Production template. Every value here is required; the server refuses to
# start in NODE_ENV=production if any safety setting is missing (src/config.js).
# Keep secrets in a secret manager or root-only files, never in git.

NODE_ENV=production
PORT=4000
LEDGER_MODE=fabric

FABRIC_MSP_ID=HospitalAMSP
FABRIC_PEER_ENDPOINT=peer0.hospitala.example:7051
FABRIC_PEER_HOST_ALIAS=peer0.hospitala.example
FABRIC_TLS_CERT_PATH=/run/secrets/fabric-tls-ca.crt
FABRIC_CERT_PATH=/run/secrets/fabric-client.crt
FABRIC_HSM_LIBRARY=/usr/lib/softhsm/libsofthsm2.so
FABRIC_HSM_LABEL=patientchain
FABRIC_HSM_PIN=
FABRIC_HSM_KEY_ID=
FABRIC_CHANNEL_NAME=patientchainchannel
FABRIC_CHAINCODE_NAME=patientchain

AUTH_MODE=oidc
OIDC_ISSUER=https://idp.hospital-a.example/realms/patientchain
OIDC_AUDIENCE=patientchain-api
OIDC_CLIENT_ID=patientchain-web
OIDC_ROLES_CLAIM=realm_access.roles

DATA_DIR=/var/lib/patientchain
DATA_ENCRYPTION_KEYS=
BACKUP_DIR=/var/backups/patientchain

CORS_ORIGINS=https://patientchain.hospital-a.example
TRUST_PROXY=1
METRICS_TOKEN=
LOG_LEVEL=info

HL7_MLLP_ENABLED=true
HL7_TLS_CERT_PATH=/run/secrets/mllp.crt
HL7_TLS_KEY_PATH=/run/secrets/mllp.key
HL7_TLS_CLIENT_CA_PATH=/run/secrets/interface-engine-ca.crt
