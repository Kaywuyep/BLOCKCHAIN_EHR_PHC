# Copy to .env and adjust.

PORT=4000

# simulated (default, no Docker/Fabric needed) | fabric (connects to the real network)
LEDGER_MODE=simulated

# --- Only required when LEDGER_MODE=fabric ---
# Connect as HospitalA's client identity. To act as HospitalB instead,
# swap every path below for the hospitalb.patientchain.local equivalents
# and set FABRIC_MSP_ID=HospitalBMSP.
FABRIC_MSP_ID=HospitalAMSP
FABRIC_PEER_ENDPOINT=localhost:7051
FABRIC_PEER_HOST_ALIAS=peer0.hospitala.patientchain.local
FABRIC_TLS_CERT_PATH=../network/crypto-config/peerOrganizations/hospitala.patientchain.local/peers/peer0.hospitala.patientchain.local/tls/ca.crt
FABRIC_CERT_PATH=../network/crypto-config/peerOrganizations/hospitala.patientchain.local/users/User1@hospitala.patientchain.local/msp/signcerts/User1@hospitala.patientchain.local-cert.pem
FABRIC_KEY_DIR=../network/crypto-config/peerOrganizations/hospitala.patientchain.local/users/User1@hospitala.patientchain.local/msp/keystore
FABRIC_CHANNEL_NAME=patientchainchannel
FABRIC_CHAINCODE_NAME=patientchain
# Production signing key alternatives (see src/services/fabricLedgerService.js):
# FABRIC_KEY_PATH=/run/secrets/fabric-client.key      # single PEM, chmod 0400
# FABRIC_HSM_LIBRARY=/usr/lib/softhsm/libsofthsm2.so  # PKCS#11 HSM
# FABRIC_HSM_LABEL=patientchain
# FABRIC_HSM_PIN=
# FABRIC_HSM_KEY_ID=

# --- Authentication ---
# off   = no login, every request is a superuser (demo only)
# local = POST /api/auth/login issues dev tokens (development only)
# oidc  = hospital identity provider (required in production)
AUTH_MODE=off
# AUTH_JWT_SECRET=<at least 32 random characters, for AUTH_MODE=local>
# OIDC_ISSUER=https://idp.hospital-a.example/realms/patientchain
# OIDC_AUDIENCE=patientchain-api
# OIDC_CLIENT_ID=patientchain-web
# OIDC_ROLES_CLAIM=realm_access.roles
# OIDC_HOSPITAL_CLAIM=hospital_id
# OIDC_PROVIDER_CLAIM=provider_id

# --- Off-chain storage ---
# DATA_DIR=./data
# DATA_ENCRYPTION_KEYS=k2026a:<base64 32 bytes>   # first key encrypts; all listed keys decrypt
# BACKUP_DIR=./data/backups

# --- HTTP ---
# CORS_ORIGINS=https://patientchain.hospital-a.example
# TRUST_PROXY=1                 # behind a TLS-terminating reverse proxy
# TLS_CERT_PATH= / TLS_KEY_PATH= # or terminate TLS in Node directly
# RATE_LIMIT_PER_MINUTE=300
# JSON_BODY_LIMIT=100kb
# METRICS_TOKEN=<random string; Prometheus sends it as a bearer token>
# LOG_LEVEL=info

# --- HL7 MLLP ---
HL7_MLLP_ENABLED=false
# HL7_TLS_CERT_PATH= / HL7_TLS_KEY_PATH=   # MLLP over TLS
# HL7_TLS_CLIENT_CA_PATH=                  # require interface-engine client certs (mTLS)
# HL7_PRIVATE_NETWORK=true                 # instead of TLS, when MLLP runs over a VPN
# HL7_MAX_ATTEMPTS=5
# HL7_RETRY_INTERVAL_MS=30000
